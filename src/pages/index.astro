---
import Base from '../layouts/Base.astro';
import Cards from '../components/Cards.astro';
import {allEntries,archive,categories,SITE} from '../lib/content';
const schema={'@context':'https://schema.org','@type':'WebSite',name:'On Simplicity',url:SITE+'/',publisher:{'@type':'Organization',name:'On Simplicity',url:SITE+'/'}};
---
<Base title="Simple Living, Home & Everyday Life" description="Practical ideas for a lighter home, a calmer day and a life with more room for what matters. Explore On Simplicity and our Resource Partners." schema={schema}>
<section class="hero"><div class="hero-copy"><p class="eyebrow">An everyday-life journal</p><h1>Less noise.<br/>More <em>living.</em></h1><p class="hero-intro">A calmer home. A clearer head. A little more space for the people and things that matter.</p><a class="button" href="/category/simple-living/">Find your simple <span aria-hidden="true">↗</span></a><a class="quiet-link" href="/archives/">Browse the journal →</a></div><div class="hero-art" role="img" aria-label="An original line illustration of a quiet corner: a green branch in an ochre vase, a book and a warm sun"><svg viewBox="0 0 500 440" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="335" cy="124" r="78" fill="#dfbd72"/><path d="M30 350h430M70 367h320" stroke="#2f4f4f" stroke-width="2"/><path d="M233 240h112l-16 109h-80z" fill="#ac6b38"/><path d="M244 251h90M255 269l10 67M278 269l3 67M301 269l-3 67M323 269l-10 67" stroke="#ead4ae" stroke-width="2"/><path d="M290 241c4-65-17-115-64-160M294 204c18-50 46-83 79-101M275 155c-45-9-83-35-102-60" stroke="#2f4f4f" stroke-width="3"/><path d="M250 109c-47 4-58-35-58-35 38-9 53 13 58 35ZM269 141c-6-46 25-61 25-61 22 32 3 51-25 61ZM300 187c14-48 52-45 52-45-3 36-25 45-52 45ZM336 130c-1-40 34-56 34-56 19 35-12 53-34 56ZM217 112c-38 18-62-11-62-11 24-22 47-13 62 11Z" fill="#2f4f4f"/><path d="M93 322h115v26H93z" fill="#ebe0c9" stroke="#2f4f4f" stroke-width="2"/><path d="M105 299h100v22H105z" fill="#718076" stroke="#2f4f4f" stroke-width="2"/><path d="M116 308h70M105 334h87" stroke="#faf7f2" stroke-width="2"/><path d="M393 250v98M378 266h30" stroke="#2f4f4f" stroke-width="2"/><circle cx="393" cy="244" r="8" fill="#c2410c"/></svg><span class="art-caption">No perfect life required.</span></div></section>
<section class="category-strip" aria-label="Explore by subject"><span class="eyebrow">Make room for</span>{categories.map(c=><a href={c.path}>{c.name}</a>)}</section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">Small shifts, real life</p><h2>The latest from the journal</h2></div><a class="text-link" href="/archives/">All stories ↗</a></div><Cards entries={allEntries.slice(0,10)}/></section>
<aside class="partner-banner"><div><p class="eyebrow">Local knowledge. Everyday help.</p><h2>Good people to know.</h2><p>Meet the businesses in our Resource Partners directory. Explore their services, read their work and decide what’s right for you.</p></div><a class="button light" href="/resource-partners/">Explore Resource Partners ↗</a></aside>
<section class="section"><div class="section-heading"><div><p class="eyebrow">A good place to begin</p><h2>Six ideas worth returning to</h2></div></div><ol class="reading-list">{archive.filter(a=>(a.id||0)<=6).map(a=><li><a href={a.path}>{a.title}<span aria-hidden="true">↗</span></a></li>)}</ol></section>
</Base>
